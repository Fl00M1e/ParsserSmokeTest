#!/usr/bin/env bash
#
# Двойной клик по этому файлу в Finder запускает парсер.
#
# В отличие от .app, собранного PyInstaller, здесь НИЧЕГО не
# заморожено в один бинарник — просто запускается обычный,
# видимый Python-код (app.py и рядом лежащие .py файлы) через
# системный python3. Поэтому нет ни проблем с кодовой подписью,
# ни ошибок в духе "файл повреждён" — их источником всегда
# является именно собранный бинарник, а не голый .py.
#
# Первый запуск займёт ~30-60 сек (ставит зависимости и venv,
# нужен интернет), все следующие — почти мгновенно, venv уже
# готов.

set -e

cd "$(dirname "$0")"

# --------------------------------------------------------------
# Проверка python3.
# --------------------------------------------------------------

if ! command -v python3 >/dev/null 2>&1; then

    osascript -e 'display alert "Python не найден" message "Для запуска парсера нужен Python 3. Сейчас откроется страница загрузки — установите Python, затем запустите этот файл ещё раз." buttons {"OK"} default button "OK"'

    open "https://www.python.org/downloads/macos/"

    exit 1

fi

# --------------------------------------------------------------
# Venv — создаём один раз, дальше просто переиспользуем.
# --------------------------------------------------------------

if [ ! -d ".venv" ]; then

    echo "Первый запуск: готовлю окружение (около минуты)..."

    python3 -m venv .venv

    source .venv/bin/activate

    python -m pip install --upgrade pip --quiet

    pip install -r requirements.txt --quiet

else

    source .venv/bin/activate

fi

# --------------------------------------------------------------
# Запуск.
# --------------------------------------------------------------

python app.py
